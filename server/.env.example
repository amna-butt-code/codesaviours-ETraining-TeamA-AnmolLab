# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/anmol_lab
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false
# Optional AI provider. The app remains usable without this key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Email (optional for local demo; Mailtrap is recommended)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Anmol Lab <no-reply@example.test>
